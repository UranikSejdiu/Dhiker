generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String?
  displayName     String?   @map("display_name")
  provider        String    @default("email")
  emailVerifiedAt DateTime? @map("email_verified_at")
  role            String    @default("user")
  theme           String    @default("dark-gold")
  language        String    @default("en")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  dhikrs   Dhikr[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Dhikr {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  totalCount    BigInt   @default(0) @map("total_count")
  dailyCount    Int      @default(0) @map("daily_count")
  dailyLimit    Int?     @map("daily_limit")
  lastResetDate DateTime @map("last_reset_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastResetDate])
  @@map("dhikrs")
}
